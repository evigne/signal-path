{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-path.local/schema/provider.schema.json",
  "title": "Ground-station provider entry",
  "type": "object",
  "required": [
    "id",
    "name",
    "last_checked",
    "cells"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "last_checked": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "const": "pending"
        }
      ]
    },
    "cells": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "cited",
              "not_public",
              "to_research"
            ]
          },
          "value": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Za-z0-9.\\-]*$"
                },
                "loc": {
                  "type": "string",
                  "description": "Section, figure or table inside the source, e.g. §9.3.1"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "state": {
              "const": "cited"
            }
          }
        },
        "then": {
          "required": [
            "value",
            "sources"
          ],
          "properties": {
            "sources": {
              "minItems": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}