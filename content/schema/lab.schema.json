{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-path.local/schema/lab.schema.json",
  "title": "Lab",
  "description": "Brief §4L lab fields; links to an interactive tool.",
  "type": "object",
  "required": [
    "id",
    "title",
    "tool",
    "level",
    "objectives",
    "prerequisites",
    "fictional_input",
    "steps",
    "expected_result",
    "explanation",
    "common_mistakes",
    "reset",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "tool": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "level": {
      "enum": [
        "intro",
        "core",
        "advanced"
      ]
    },
    "est_minutes": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "fictional_input": {
      "type": "object",
      "required": [
        "description",
        "data"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "label": {
          "const": "example"
        }
      },
      "additionalProperties": false
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "settings"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "settings": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "break_it": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "instruction",
          "expected"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "expected_result": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reset": {
      "type": "string"
    },
    "accessibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Za-z0-9.\\-]*$"
          },
          "loc": {
            "type": "string",
            "description": "Section, figure or table inside the source, e.g. §9.3.1"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}