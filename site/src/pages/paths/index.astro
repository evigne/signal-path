---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import { sortedPaths, pathHref } from '../../lib/site';
const paths = await sortedPaths();
---
<Base title="Learning paths" section="start-here">
  <div class="mx-auto max-w-[1200px] px-4 py-8 md:px-8">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { label: 'Learning paths' }]} />
    <h1 class="t-h1 mt-4">Learning paths</h1>
    <p class="t-body-lg mt-2 max-w-[720px] text-fg-2">Ordered routes through the topics and labs for different roles. Progress is kept in this browser only.</p>
    <ol class="mt-8 grid gap-4 md:grid-cols-2">
      {paths.map((p, i) => (
        <li>
          <a href={pathHref(p.id)} class="card group flex h-full flex-col gap-2 p-5 text-fg no-underline hover:border-line-strong hover:bg-subtle">
            <span class="t-overline text-fg-2">Path {i + 1}</span>
            <span class="t-h3 group-hover:text-link">{p.data.title}</span>
            <span class="text-fg-2">{p.data.audience}</span>
            <span class="t-small text-fg-2">{p.data.modules.map((m) => m.title).join(' · ')}</span>
            <span class="mt-auto flex items-center gap-2 pt-3 text-xs text-fg-muted"><LevelBadge level={p.data.level} />{p.id === 'fast-reference' ? 'As needed' : `${p.data.est_hours[0]}–${p.data.est_hours[1]} h`}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
