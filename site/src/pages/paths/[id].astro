---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import Icon from '../../components/Icon.astro';
import PathProgress from '../../components/islands/PathProgress.tsx';
import { PATH_ORDER, topicHref, labHref, pathHref, minutes } from '../../lib/site';

export async function getStaticPaths() {
  const paths = await getCollection('paths');
  return paths.map((p) => ({ params: { id: p.id }, props: { path: p } }));
}
const { path } = Astro.props;
const d = path.data;
const topics = new Map((await getCollection('topics')).map((t) => [t.id, t]));
const labs = new Map((await getCollection('labs')).map((l) => [l.id, l]));
const allPaths = new Map((await getCollection('paths')).map((p) => [p.id, p.data.title]));
const titles = Object.fromEntries([...topics].map(([id, t]) => [id, t.data.title]));
const n = PATH_ORDER.indexOf(path.id) + 1;
const modMinutes = (ts: string[]) => ts.reduce<[number, number]>((acc, t) => {
  const m = topics.get(t)?.data.est_minutes ?? [0, 0];
  return [acc[0] + m[0], acc[1] + m[1]];
}, [0, 0]);
const first = d.modules[0]?.topics[0];
---
<Base title={d.title} description={d.audience} section="start-here">
  <div class="mx-auto grid max-w-[1200px] gap-8 px-4 py-8 md:px-8 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div class="min-w-0">
      <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/paths/', label: 'Learning paths' }, { label: d.title }]} />
      <p class="t-overline mt-4 text-fg-2">Path {n} · {d.level}</p>
      <h1 class="t-h1 mt-1">{d.title}</h1>
      <p class="t-body-lg mt-2 max-w-[720px] text-fg-2">{d.audience}.</p>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-fg-2">
        <LevelBadge level={d.level} />
        <span>{path.id === 'fast-reference' ? 'As needed' : `${d.est_hours[0]}–${d.est_hours[1]} h total`}</span>
        <span>Prerequisites: {d.prerequisites.filter((p) => p !== 'None').length ? d.prerequisites.map((p) => <a href={pathHref(p)}>{allPaths.get(p) ?? p}</a>) : 'none'}</span>
      </div>
      {first && <a class="btn btn-primary mt-5" href={topicHref(first)}>Start: {titles[first]} <Icon name="arrow-right" size={16} /></a>}

      <h2 class="t-h2 mt-10">Modules</h2>
      <ol class="mt-4 space-y-4">
        {d.modules.map((m, i) => (
          <li class="card p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div>
                <p class="t-overline text-fg-2">Module {i + 1}</p>
                <h3 class="t-h4">{m.title}</h3>
              </div>
              <span class="t-label-sm text-fg-muted">{minutes(modMinutes(m.topics))}</span>
            </div>
            <ul class="mt-3 space-y-1.5 text-[15px]">
              {m.topics.map((t) => (
                <li class="flex items-start gap-2"><span class="mt-1 text-fg-muted"><Icon name="book" size={16} /></span><a href={topicHref(t)}>{titles[t] ?? t}</a></li>
              ))}
              {(m.labs ?? []).map((l) => (
                <li class="flex items-start gap-2"><span class="mt-1 text-fg-muted"><Icon name="flask" size={16} /></span><a href={labHref(l)}>Lab: {labs.get(l)?.data.title ?? l}</a></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
    <aside class="space-y-4 lg:sticky lg:top-32 lg:self-start">
      <PathProgress client:load modules={d.modules.map((m) => ({ title: m.title, topics: m.topics }))} titles={titles} />
      <div class="card p-5">
        <p class="t-label">Milestones</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-fg-2">{d.milestones.map((m) => <li>{m}</li>)}</ul>
      </div>
      <div class="card p-5">
        <p class="t-label">You will be able to</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-fg-2">{d.outcomes.map((o) => <li>{o}</li>)}</ul>
      </div>
    </aside>
  </div>
</Base>
