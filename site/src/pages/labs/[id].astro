---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import SourceList from '../../components/SourceList.astro';
import Icon from '../../components/Icon.astro';
import PacketDecoder from '../../components/islands/PacketDecoder.tsx';
import DataBudget from '../../components/islands/DataBudget.tsx';
import BitInspector from '../../components/islands/BitInspector.tsx';
import Calibration from '../../components/islands/Calibration.tsx';
import Cop1Sim from '../../components/islands/Cop1Sim.tsx';
import Walkthrough from '../../components/islands/Walkthrough.tsx';
import DecisionTree from '../../components/islands/DecisionTree.tsx';
import SyncVisualizer from '../../components/islands/SyncVisualizer.tsx';
import CodingSandbox from '../../components/islands/CodingSandbox.tsx';
import { topicHref, minutes } from '../../lib/site';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map((l) => ({ params: { id: l.id }, props: { lab: l } }));
}
const { lab } = Astro.props;
const d = lab.data;
const titles = new Map((await getCollection('topics')).map((t) => [t.id, t.data.title]));
const live = [1, 2, 3, 4, 5, 6, 7, 8, 9].includes(d.tool);
---
<Base title={d.title} description={d.objectives[0]} section="labs">
  <div class="mx-auto max-w-[1280px] px-4 py-8 md:px-8">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/labs/', label: 'Labs' }, { label: d.title }]} />
    <p class="t-overline mt-4 text-fg-2">Tool {d.tool} · Interactive lab</p>
    <h1 class="t-h1 mt-1">{d.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-fg-2">
      <LevelBadge level={d.level} />
      {d.est_minutes && <span class="inline-flex items-center gap-1"><Icon name="clock" size={16} />{minutes(d.est_minutes)}</span>}
      <span class="label-chip label-example">Illustrative example · fictional data</span>
      {d.prerequisites.length > 0 && <span>Before this: {d.prerequisites.map((p, i) => <>{i > 0 && ', '}<a href={topicHref(p)}>{titles.get(p) ?? p}</a></>)}</span>}
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <section class="card p-5" aria-labelledby="obj">
        <h2 id="obj" class="t-h4">Objectives</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-[15px]">{d.objectives.map((o) => <li>{o}</li>)}</ul>
      </section>
      <section class="card p-5" aria-labelledby="input">
        <h2 id="input" class="t-h4">Fictional input</h2>
        <p class="mt-2 text-[15px]">{d.fictional_input.description}</p>
        <p class="t-code-sm mt-2 break-words rounded-md bg-subtle p-2">{d.fictional_input.data}</p>
      </section>
    </div>

    <section class="mt-8" aria-labelledby="tool">
      <h2 id="tool" class="t-h2 mb-4">The tool</h2>
      {d.tool === 2 && <PacketDecoder client:load />}
      {d.tool === 7 && <DataBudget client:load />}
      {d.tool === 1 && <BitInspector client:load />}
      {d.tool === 5 && <Calibration client:load />}
      {d.tool === 6 && <Cop1Sim client:load />}
      {d.tool === 8 && <Walkthrough client:load />}
      {d.tool === 9 && <DecisionTree client:load />}
      {d.tool === 3 && <SyncVisualizer client:load />}
      {d.tool === 4 && <CodingSandbox client:load />}
      {!live && (
        <div class="card flex items-start gap-3 p-5">
          <span class="text-link"><Icon name="info" size={20} /></span>
          <div>
            <p class="font-medium">The interactive version of this tool is being built.</p>
            <p class="t-small mt-1 text-fg-2">The steps below already work as a guided exercise; the presets list the settings the tool will offer.</p>
            {d.presets.length > 0 && <p class="t-small mt-2">Presets: {d.presets.map((p) => p.name).join(' · ')}</p>}
          </div>
        </div>
      )}
    </section>

    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
      <section aria-labelledby="steps">
        <h2 id="steps" class="t-h2">Steps</h2>
        <ol class="mt-4 space-y-3">
          {d.steps.map((s, i) => (
            <li class="card p-4">
              <p class="t-overline text-fg-2">Step {i + 1}</p>
              <p class="t-h4">{s.title}</p>
              <p class="mt-1 text-[15px]">{s.instruction}</p>
              <details class="mt-2 text-[15px]">
                <summary class="cursor-pointer text-link">Show expected result</summary>
                <p class="mt-1 text-fg-2">{s.expected}</p>
                {s.hint && <p class="t-small mt-1 text-fg-2">Hint: {s.hint}</p>}
              </details>
            </li>
          ))}
        </ol>
      </section>
      <aside class="space-y-4">
        {d.break_it.length > 0 && (
          <div class="card p-4">
            <p class="t-label">Break it</p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-fg-2">{d.break_it.map((b) => <li>{b}</li>)}</ul>
          </div>
        )}
        <div class="card p-4">
          <p class="t-label">Expected result</p>
          <p class="mt-1 text-sm text-fg-2">{d.expected_result}</p>
          <p class="t-label mt-3">Why</p>
          <p class="mt-1 text-sm text-fg-2">{d.explanation}</p>
        </div>
        <div class="card p-4">
          <p class="t-label">Common mistakes</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-fg-2">{d.common_mistakes.map((m) => <li>{m}</li>)}</ul>
          <p class="t-small mt-3 text-fg-muted">Reset: {d.reset}</p>
        </div>
        {d.accessibility.length > 0 && (
          <div class="card p-4">
            <p class="t-label">Accessibility</p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-fg-2">{d.accessibility.map((a) => <li>{a}</li>)}</ul>
          </div>
        )}
      </aside>
    </div>

    <section class="mt-10 max-w-[720px]"><SourceList refs={d.sources} heading="Sources" /></section>
  </div>
</Base>
