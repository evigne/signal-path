---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="mx-auto max-w-[720px] px-4 py-16 md:px-8">
    <p class="t-overline text-fg-2">Error 404</p>
    <h1 class="t-h1 mt-2">Loss of signal</h1>
    <p class="t-body-lg mt-3 text-fg-2">This page isn't here. Try <a href="/search/">search</a>, <a href="/start-here/">Start Here</a> or the <a href="/glossary/">glossary</a>.</p>
  </div>
</Base>
