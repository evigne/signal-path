---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ChainDiagram from '../components/ChainDiagram.astro';
import Card from '../components/Card.astro';
import LabelChip from '../components/LabelChip.astro';
import LevelBadge from '../components/LevelBadge.astro';
import Icon from '../components/Icon.astro';
import OrbitalPass from '../components/islands/OrbitalPass.tsx';
import { sortedPaths, pathHref, topicHref, labHref, symptomHref, standardHref, pathTier } from '../lib/site';

const paths = await sortedPaths();
const topics = await getCollection('topics');
const labs = await getCollection('labs');
const TIERS = [
  { tag: 'BEGINNER', title: 'New to space comms?', text: 'Why space links are different, a pass minute by minute, and the vocabulary — no background needed.', cta: 'Start here', path: 'space-comms-101', primary: true },
  { tag: 'INTERMEDIATE', title: 'Talk with operators', text: 'Frames, packets, coding, commanding and troubleshooting, with labs.', cta: 'Core path', path: 'operator-conversation-fluency', primary: false },
  { tag: 'EXPERT', title: 'Go deep on the link', text: 'Link budgets, modulation, high-rate coding, ranging and USLP.', cta: 'Deep dive', path: 'communications-deep-dive', primary: false },
];
const claimCount = topics.reduce((n, t) => n + (t.body?.match(/^:::claim\{/gm)?.length ?? 0), 0);
---
<Base title="Signal Path">
  <section class="bg-reticle border-b border-line">
    <div class="mx-auto grid max-w-[1440px] gap-10 px-4 py-12 md:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,600px)] lg:py-16">
      <div>
        <p class="t-overline text-link">Spacecraft communications &amp; operations</p>
        <h1 class="t-display mt-3 max-w-[760px]">Follow data from a spacecraft sensor to a mission screen — and commands back.</h1>
        <p class="t-body-lg mt-4 max-w-[640px] text-fg-2">
          Learn how telemetry comes down and commands go up through onboard software, radio links, ground stations and networks to mission control. Then learn to troubleshoot it, layer by layer.
        </p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-3" aria-label="Where to start">
          {TIERS.map((tier) => (
            <li>
              <a href={pathHref(tier.path)} class:list={['card group flex h-full flex-col gap-1 p-4 no-underline hover:border-line-strong', tier.primary && '!border-accent']}>
                <span class="t-readout text-xs text-fg-muted">{tier.tag}</span>
                <span class="t-h4 text-fg group-hover:text-link">{tier.title}</span>
                <span class="t-small text-fg-2">{tier.text}</span>
                <span class="mt-auto inline-flex items-center gap-1 pt-2 text-sm text-link">{tier.cta} <Icon name="arrow-right" size={14} /></span>
              </a>
            </li>
          ))}
        </ul>
        <dl class="t-readout mt-8 flex flex-wrap gap-x-8 gap-y-2 text-sm text-fg-2">
          <div class="flex gap-2"><dt>TOPICS</dt><dd class="text-fg">{topics.length}</dd></div>
          <div class="flex gap-2"><dt>PATHS</dt><dd class="text-fg">{paths.length}</dd></div>
          <div class="flex gap-2"><dt>LABS</dt><dd class="text-fg">{labs.length}</dd></div>
          <div class="flex gap-2"><dt>CITED CLAIMS</dt><dd class="text-fg">{claimCount}</dd></div>
        </dl>
      </div>
      <div class="self-center"><OrbitalPass client:load /></div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 py-12 md:px-8" aria-labelledby="chain">
    <h2 id="chain" class="t-h2">The end-to-end system</h2>
    <p class="mt-2 max-w-[720px] text-fg-2">Two directions through the same chain. Each stage has an owner, a data unit and its own failure modes.</p>
    <div class="mt-6"><ChainDiagram /></div>
    <p class="mt-3 text-sm"><a href={topicHref('end-to-end-system')}>Read: The end-to-end system →</a></p>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 py-8 md:px-8" aria-labelledby="paths">
    <h2 id="paths" class="t-h2">Learning paths</h2>
    <p class="mt-2 max-w-[720px] text-fg-2">Pick a path for your role. Paths share topics, so progress in one counts in the others.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {paths.map((p) => (
        <a href={pathHref(p.id)} class="card group flex flex-col gap-2 p-5 text-fg no-underline hover:border-line-strong hover:bg-subtle">
          <span class="t-overline text-fg-2">{pathTier(p)} path</span>
          <span class="t-h4 group-hover:text-link">{p.data.title}</span>
          <span class="t-small text-fg-2">{p.data.audience}</span>
          <span class="mt-auto flex items-center gap-2 pt-3 text-xs text-fg-muted">
            <LevelBadge level={p.data.level} />
            {p.id === 'fast-reference' ? 'As needed' : `${p.data.est_hours[0]}–${p.data.est_hours[1]} h`} · {p.data.modules.length} modules
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 py-8 md:px-8" aria-labelledby="labels">
    <h2 id="labels" class="t-h2">How content is labelled</h2>
    <p class="mt-2 max-w-[720px] text-fg-2">Every claim carries one of four labels, with an icon and text, never colour alone. "Mission-specific" always means: check your own mission documents.</p>
    <ul class="mt-4 flex flex-wrap gap-3">
      <li><LabelChip label="standard" /></li>
      <li><LabelChip label="practice" /></li>
      <li><LabelChip label="example" /></li>
      <li><LabelChip label="mission" /></li>
    </ul>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 py-8 md:px-8" aria-labelledby="popular">
    <h2 id="popular" class="t-h2">Popular starting points</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <Card href={topicHref('uplink-and-downlink')} kind="Topic" icon="book" title="Uplink and downlink" text="What flows in each direction, and why the two paths differ." meta="Intro · 15–20 min" />
      <Card href={labHref('space-packet-header-decoder')} kind="Lab" icon="flask" title="Packet header decoder" text="Decode a fictional Space Packet primary header field by field." meta="Core · 15–25 min" />
      <Card href={symptomHref('carrier-but-no-frame-lock')} kind="Symptom" icon="alert" title="Carrier but no frame lock" text="Evidence to gather and layers to check when frames never sync." meta="Troubleshooting" />
      <Card href={standardHref('ccsds-133-0-b-2')} kind="Standard" icon="layers" title="Space Packet Protocol" text="CCSDS 133.0-B-2: scope, structure and what the mission must define." meta="Reference" />
    </div>
  </section>
</Base>
