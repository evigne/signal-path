---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import { symptomHref, topicHref } from '../../lib/site';
const syms = (await getCollection('symptoms')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Base title="Symptom guides" section="symptoms">
  <div class="mx-auto max-w-[1200px] px-4 py-8 md:px-8">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/section/troubleshooting/', label: 'Troubleshooting' }, { label: 'Symptom guides' }]} />
    <h1 class="t-h1 mt-4">Symptom guides</h1>
    <p class="t-body-lg mt-2 max-w-[720px] text-fg-2">Start from what you see. Each guide lists evidence, likely causes with tests, and who to involve. Work the layers in order — see <a href={topicHref('layered-fault-isolation')}>layered fault isolation</a>.</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {syms.map((s) => <Card href={symptomHref(s.id)} kind={s.data.layer} icon="alert" title={s.data.title} text={s.data.observables.join(' · ')} />)}
    </div>
  </div>
</Base>
