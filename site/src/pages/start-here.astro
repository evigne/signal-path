---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TopicList from '../components/TopicList.astro';
import ChainDiagram from '../components/ChainDiagram.astro';
import { SECTIONS, byTeachingOrder, pathHref } from '../lib/site';

const topics = await getCollection('topics');
const start = topics.filter((t) => t.data.section === 'start-here').sort(byTeachingOrder);
const counts = new Map(SECTIONS.map((s) => [s.id, topics.filter((t) => t.data.section === s.id).length]));
---
<Base title="Start Here" section="start-here">
  <div class="mx-auto max-w-[1200px] px-4 py-8 md:px-8">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { label: 'Start Here' }]} />
    <h1 class="t-h1 mt-4">Start Here</h1>
    <p class="t-body-lg mt-2 max-w-[720px] text-fg-2">Begin with why space links are different, then the whole chain and the two directions. Every other page fits somewhere on this picture.</p>
    <p class="mt-3 text-[15px]">New to all of this? Follow the <a href={pathHref('space-comms-101')}>Space comms 101</a> path — no background needed.</p>
    <div class="mt-8"><TopicList topics={start} /></div>
    <div class="mt-10"><ChainDiagram /></div>

    <h2 class="t-h2 mt-12">All sections</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {SECTIONS.filter((s) => s.id !== 'start-here').map((s) => (
        <li>
          <a href={s.id === 'labs' ? '/labs/' : `/section/${s.id}/`} class="card group flex h-full flex-col gap-1 p-4 text-fg no-underline hover:border-line-strong hover:bg-subtle">
            <span class="t-h4 group-hover:text-link">{s.title}</span>
            <span class="t-small text-fg-2">{s.blurb}</span>
            {s.id !== 'labs' && <span class="mt-auto pt-2 text-xs text-fg-muted">{counts.get(s.id)} topics</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
