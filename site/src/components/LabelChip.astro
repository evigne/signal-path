---
import { LABEL_TEXT } from '../lib/site';
interface Props { label: string; short?: boolean }
const { label, short } = Astro.props;
const ICONS: Record<string, string> = {
  standard: 'M4 3h9a3 3 0 0 1 3 3v11H7a3 3 0 0 0-3 3V3Zm0 17a3 3 0 0 1 3-3h9',
  practice: 'M10 2l2.4 5 5.6.8-4 3.9.9 5.5L10 14.6 5.1 17.2l.9-5.5-4-3.9L7.6 7Z',
  example: 'M7 2h6v5l4 9a2 2 0 0 1-1.8 2.8H4.8A2 2 0 0 1 3 16l4-9V2Zm-1 0h8',
  mission: 'M4 18V3m0 1h10l-2 3.5L14 11H4',
};
const text = LABEL_TEXT[label] ?? label;
---
<span class={`label-chip label-${label}`}>
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ICONS[label]} /></svg>
  {short ? text.split(' ')[0].replace('-defined', '') : text}
</span>
